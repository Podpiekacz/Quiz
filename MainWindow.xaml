<Window x:Class="QuizApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuizMaster Pro" 
        Height="780" Width="1100"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Window.Resources>
        <!-- Fade in animation storyboard -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Background gradient overlay -->
        <Border Background="{StaticResource BgGradientBrush}"/>
        
        <!-- Decorative gradient orbs -->
        <Ellipse Width="500" Height="500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-100,0" Opacity="0.06">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#6C63FF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="400" Height="400" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-100,0,0,-100" Opacity="0.05">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF6584" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Main content container -->
        <Grid Margin="0">
            <!-- ============ HOME / QUIZ LIST VIEW ============ -->
            <Grid x:Name="HomeView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="40,30,40,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="✨ QuizMaster Pro" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Select a quiz to get started, or create your own!" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="＋  Create New Quiz" Click="CreateQuiz_Click" VerticalAlignment="Center" FontSize="15"/>
                    </Grid>
                </Border>

                <!-- Quiz cards grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="40,10,40,30">
                    <ItemsControl x:Name="QuizList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ============ QUIZ TAKING VIEW ============ -->
            <Grid x:Name="QuizTakingView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Quiz header with progress -->
                <Border Grid.Row="0" Padding="40,25,40,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="← Back to Quizzes" Click="BackToHome_Click"/>
                            <TextBlock x:Name="QuizTitleText" Grid.Column="1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QuestionCounter" Grid.Column="2" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Progress bar -->
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Border Background="{StaticResource BgLightBrush}" CornerRadius="4" Height="8"/>
                            <Border x:Name="ProgressBarFill" Background="{StaticResource AccentGradientBrush}" CornerRadius="4" Height="8" HorizontalAlignment="Left" Width="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#6C63FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Question content area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Padding="40,10,40,20" MaxWidth="750" HorizontalAlignment="Center">
                        <StackPanel x:Name="QuestionArea">
                            <!-- Question type badge -->
                            <Border x:Name="QuestionTypeBadge" Background="#1A6C63FF" CornerRadius="12" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,16">
                                <TextBlock x:Name="QuestionTypeText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}"/>
                            </Border>

                            <!-- Question text -->
                            <TextBlock x:Name="QuestionText" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="32"/>

                            <!-- Answer area - dynamically populated -->
                            <StackPanel x:Name="AnswerPanel"/>

                            <!-- Feedback area (shown after answering) -->
                            <Border x:Name="FeedbackPanel" Visibility="Collapsed" CornerRadius="12" Padding="20" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="FeedbackIcon" FontSize="28" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="FeedbackText" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="ExplanationText" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Bottom action bar -->
                <Border Grid.Row="2" Padding="40,15,40,25">
                    <Grid>
                        <Button x:Name="SubmitAnswerBtn" Style="{StaticResource PrimaryButton}" Content="Submit Answer" HorizontalAlignment="Center" Click="SubmitAnswer_Click" FontSize="15" Padding="40,14"/>
                        <Button x:Name="NextQuestionBtn" Style="{StaticResource PrimaryButton}" Content="Next Question →" HorizontalAlignment="Center" Click="NextQuestion_Click" Visibility="Collapsed" FontSize="15" Padding="40,14"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ QUIZ RESULTS VIEW ============ -->
            <Grid x:Name="ResultsView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="700" Margin="40">
                        <!-- Score card -->
                        <Border CornerRadius="20" Padding="40,35" Margin="0,20,0,30">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E1E35" Offset="0"/>
                                    <GradientStop Color="#2A2A4A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="ResultEmoji" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock x:Name="ResultTitle" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ResultSubtitle" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,20"/>
                                
                                <!-- Score circle -->
                                <Grid Width="150" Height="150" Margin="0,0,0,20">
                                    <Ellipse Stroke="{StaticResource BgLightBrush}" StrokeThickness="8" Fill="Transparent"/>
                                    <Ellipse x:Name="ScoreCircle" StrokeThickness="8" Fill="Transparent" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="ScorePercentText" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ScoreDetailText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Question review list -->
                        <TextBlock Text="Question Review" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <StackPanel x:Name="ReviewPanel"/>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,20">
                            <Button Style="{StaticResource PrimaryButton}" Content="🏠 Back to Home" Click="BackToHome_Click" Margin="0,0,10,0"/>
                            <Button x:Name="RetryQuizBtn" Style="{StaticResource SecondaryButton}" Content="🔄 Try Again" Click="RetryQuiz_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ QUIZ CREATOR VIEW ============ -->
            <Grid x:Name="CreatorView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Creator header -->
                <Border Grid.Row="0" Padding="40,25,40,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="← Back" Click="BackToHome_Click"/>
                        <TextBlock Grid.Column="1" Text="Create New Quiz" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Creator content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="750" HorizontalAlignment="Center" Margin="40,10,40,20">
                        <!-- Quiz metadata -->
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="28" Margin="0,0,0,20"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="Quiz Details" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                
                                <TextBlock Text="Title" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="CreatorTitle" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                                <TextBlock Text="Description" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="CreatorDescription" Style="{StaticResource ModernTextBox}" TextWrapping="Wrap" AcceptsReturn="True" Height="70" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Category" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="CreatorCategory" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Icon Emoji" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="CreatorEmoji" Style="{StaticResource ModernTextBox}" Text="📝" MaxLength="4"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Questions section -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Questions" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QuestionCountLabel" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Question list -->
                        <StackPanel x:Name="CreatorQuestionList"/>

                        <!-- Add question button -->
                        <Button Style="{StaticResource SecondaryButton}" Content="＋  Add Question" Click="AddQuestion_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Creator footer -->
                <Border Grid.Row="2" Padding="40,15,40,25">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="BackToHome_Click" Margin="0,0,15,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="💾  Save Quiz" Click="SaveQuiz_Click" FontSize="15" Padding="40,14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
